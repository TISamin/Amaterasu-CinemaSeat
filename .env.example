# CinemaSeat environment configuration
# Copy this file to `.env` and adjust as needed. Do NOT commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=cinemaseat
POSTGRES_USER=cinemaseat
POSTGRES_PASSWORD=cinemaseat
POSTGRES_PORT=5432

# Backend JDBC URL (used inside the api container)
DATABASE_URL=jdbc:postgresql://postgres:5432/cinemaseat

# --- Backend ---
# Matches Agent 1's `server.port: ${API_PORT:8080}` in application.yml.
API_PORT=8080
HOLD_TTL_SECONDS=120

# --- Provided Gateway (asifmahmoud414/mock-gateway:latest) ---
# Service name on the Docker network is `gateway`. Do NOT use localhost.
GATEWAY_URL=http://gateway:9000
GATEWAY_PORT=9000
# Hard ceiling on any single gateway HTTP call (milliseconds).
GATEWAY_TIMEOUT_MS=5000
# Stable secret for HMAC-SHA256 signature verification (bonus feature).
GATEWAY_SECRET=change-me-in-real-deployments
# Where the gateway POSTs terminal payment statuses. Wired by docker-compose
# already; override only when running outside Docker.
CALLBACK_URL=http://api:8080/api/payments/callback

# --- Frontend ---
FRONTEND_PORT=8080
# The browser cannot reach Docker service names directly; the frontend uses
# the relative `/api` prefix and is reverse-proxied to the backend.
# When running outside Docker (e.g. `npm run dev`), set this to the API URL.
VITE_API_BASE_URL=http://localhost:8080