# --- API server ---
API_HOST=0.0.0.0
API_PORT=3000
# Service name other Compose services use to reach this backend.
# Used to build callback_url sent to the gateway.
BACKEND_SERVICE_NAME=api

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cinemaseat

# --- Gateway ---
GATEWAY_BASE_URL=http://gateway:9000
GATEWAY_PATH_PREFIX=
GATEWAY_TIMEOUT_MS=5000
# Optional HMAC verification of callback X-Signature header
GATEWAY_SECRET=
HMAC_ENABLED=false
SIGNATURE_ENCODING=hex
